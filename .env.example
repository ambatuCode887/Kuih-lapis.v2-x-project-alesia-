GOOGLE_GENAI_USE_ENTERPRISE=0
GOOGLE_API_KEY=your_google_api_key_here
LLM_PROVIDER=google
LLM_MODEL=gemini-3.5-flash
# Optional local chat model:
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_BASE_URL=http://localhost:11434
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Embeddings
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
GOOGLE_EMBEDDING_REQUEST_DELAY_SECONDS=2.0

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=multi_agentic_rag_gemini

# VirusTotal read-only reputation checks
VTAI_TOKEN=your_virustotal_ai_token_here

# Review queue (Google Sheet)
REVIEW_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=

# Confluence direct REST publishing
# CONFLUENCE_BASE_URL=https://your-company.atlassian.net/wiki
# CONFLUENCE_EMAIL=you@example.com
# CONFLUENCE_API_TOKEN=your_confluence_api_token_here
# CONFLUENCE_SPACE_KEY=YOUR_SPACE_KEY
# CONFLUENCE_PARENT_ID=
